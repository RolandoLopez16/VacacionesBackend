NODE_ENV=development
PORT=3000
STORAGE_MODE=mongo
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<source-database>?retryWrites=true&w=majority
MONGODB_DATABASE=efagram_vacaciones
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
SEED_DEMO_DATA=false
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=86400000
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
MAX_IMPORT_ROWS=5000
MAX_PAGE_SIZE=100
LOG_LEVEL=info
