{
  "name": "@vaca-efa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dist/src/bootstrap/server.js",
    "build:dev": "tsc -p tsconfig.json && node dist/src/bootstrap/server.js",
    "build": "tsc -p tsconfig.json",
    "db:reset": "npm run build && node dist/src/infrastructure/database/reset.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vaca-efa/contracts": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "pdfkit": "^0.19.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
